{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project for the main site, https://liftyapp.pages.dev
  // (npm run deploy). The app is static: public/ is uploaded as-is.
  // The other Pages projects are deployed with an explicit --project-name:
  //   liftyautopush  head of main (.github/workflows/deploy-autopush.yml)
  //   lifty-preview  pull-request previews (.github/workflows/preview-deploy.yml)
  // public/404.html keeps missing files real 404s (see docs/ARCHITECTURE.md).
  "name": "liftyapp",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-15"
}
